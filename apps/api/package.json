{
  "name": "@pentimes/api",
  "version": "0.0.1",
  "description": "Pen Times Magazine — Express + GraphQL Yoga API",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:full": "cd ../.. && pnpm --filter shared build && cd apps/api && tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@pentimes/shared": "workspace:*",
    "@pothos/core": "^4.12.0",
    "@pothos/plugin-errors": "^4.9.0",
    "@pothos/plugin-relay": "^4.7.0",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "argon2": "0.41.1",
    "cloudinary": "2.4.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.33.0",
    "express": "4.21.0",
    "express-rate-limit": "7.4.0",
    "graphql": "16.9.0",
    "graphql-yoga": "5.7.0",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "pg": "8.13.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/node": "20.16.5",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.24.2",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  }
}