# ──────────────────────────────────────────────────────────────────
# Pen Times Magazine — Production Environment Variables
# Copy to .env.production on your server. NEVER commit this file.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
NODE_ENV=production
API_PORT=4000

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=pentimes_prod
POSTGRES_USER=pentimes_prod_user
POSTGRES_PASSWORD=REPLACE_WITH_VERY_STRONG_PASSWORD_32_CHARS_MIN
DATABASE_URL=postgresql://pentimes_prod_user:REPLACE_WITH_VERY_STRONG_PASSWORD_32_CHARS_MIN@postgres:5432/pentimes_prod

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_PRODUCTION_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_PRODUCTION_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_production_cloudinary_api_key
CLOUDINARY_API_SECRET=your_production_cloudinary_api_secret

# ── Frontend ──────────────────────────────────────────────────────
# These are baked into the Next.js build via docker-compose.prod.yml args
# Nginx serves the API on the same origin (/graphql, /upload), so this is the
# site URL itself: no trailing slash, no separate api. subdomain needed.
NEXT_PUBLIC_API_URL=https://pentimes.ng
NEXT_PUBLIC_SITE_URL=https://pentimes.ng
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_production_cloudinary_cloud_name

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=https://pentimes.ng
COOKIE_DOMAIN=pentimes.ng
COOKIE_SECURE=true

# ── Proxy & rate limiting ─────────────────────────────────────────
# Number of reverse proxies in front of the API (Nginx = 1, Cloudflare + Nginx = 2)
TRUST_PROXY=1
RATE_LIMIT_GRAPHQL_MAX=300