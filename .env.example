# ──────────────────────────────────────────────────────────────────
# Pen Times Magazine — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=pentimes
POSTGRES_USER=pentimes_user
POSTGRES_PASSWORD=change_me_strong_password_here
DATABASE_URL=postgresql://pentimes_user:change_me_strong_password_here@localhost:5434/pentimes

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Required in production only (leave empty for dev)
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_char_hex_string_here
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_string_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Frontend (public — baked into Next.js build) ──────────────────
NEXT_PUBLIC_API_URL=https://unblanched-chara-backward.ngrok-free.dev/graphql
NEXT_PUBLIC_SITE_URL=https://unblanched-chara-backward.ngrok-free.dev
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGIN=https://unblanched-chara-backward.ngrok-free.dev
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false