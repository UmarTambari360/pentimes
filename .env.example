# ─────────────────────────────────────────────────────────────
# Pen Times Magazine — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://pentimes_user:pentimes_password@localhost:5432/pentimes_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Secrets ────────────────────────────────────────────────
# Generate both with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_secret_here

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Cloudinary ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── API ────────────────────────────────────────────────────────
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Web ────────────────────────────────────────────────────────
WEB_PORT=3000

# ── PostgreSQL Docker service ──────────────────────────────────
POSTGRES_DB=pentimes_db
POSTGRES_USER=pentimes_user
POSTGRES_PASSWORD=pentimes_password

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Cookie ─────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false