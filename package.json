{
  "name": "pentimes",
  "version": "1.0.0",
  "description": "Pen Times Magazine — A modern digital news platform based in Katsina, Nigeria",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter shared build && pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter shared build && pnpm --filter api dev",
    "build": "pnpm --filter shared build && pnpm --parallel --filter './apps/*' build",
    "build:web": "pnpm --filter shared build && pnpm --filter web build",
    "build:api": "pnpm --filter shared build && pnpm --filter api build",
    "typecheck": "pnpm --filter shared typecheck && pnpm --filter api typecheck && pnpm --filter web typecheck",
    "lint": "pnpm --recursive lint",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:push": "pnpm --filter api db:push",
    "db:studio": "pnpm --filter api db:studio",
    "docker:dev": "docker compose up --build",
    "docker:dev:d": "docker compose up --build -d",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v --remove-orphans"
  },
  "dependencies": {
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-horizontal-rule": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6"
  }
}